  "handlers": [
    {
      "code": "screenTick() -- fix: was NestCo.update(); one page per tick, no coroutine",
      "filter": {
        "args": [
          {
            "value": "update"
          }
        ],
        "signature": "onTimer(tag)",
        "slotKey": "-1"
